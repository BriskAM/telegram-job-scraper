# ============================================
# Telegram Scraper Bot Configuration
# ============================================
# Copy this file to .env and fill in your values

# --- Telegram Scraping (User Account via Telethon) ---
# Get your api_id and api_hash from https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+919876543210

# --- Telegram Bot (for notifications) ---
# Create a bot at https://t.me/BotFather → /newbot
# Copy the token it gives you
# For a private channel: create a channel, add your bot as admin, forward any message
#   from the channel to @RawDataBot to get the channel_id (looks like -100123456789)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_or_channel_id_here

# --- Gemini AI ---
# Get your API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
FALLBACK_MODEL=gemini-3.5-flash

# --- Your Preferences (what you're looking for) ---
PREFERENCES=I am looking for internships and entry-level roles for 2027 batch. Any location, any specialization. Also include roles where batch is unspecified.
EXCLUDE_KEYWORDS=senior, staff, lead, 5+ years, 3+ years, experienced, architect

# --- Channels to scrape (comma-separated) ---
# You must be a member of these channels
CHANNELS_TO_SCRAPE=@channel1,@channel2,@channel3

MAX_MESSAGES_PER_CHANNEL=50
MAX_MESSAGES_FIRST_RUN=200
FIRST_RUN_DAYS=7

ENABLE_DEDUP=true
DEDUP_WINDOW_DAYS=3

DATA_DIR=./data
